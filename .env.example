# Telegram
BOT_TOKEN=your_telegram_bot_token

# Database (Postgres in prod, SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://taxibek:CHANGE_ME@postgres:5432/taxibek
POSTGRES_DB=taxibek
POSTGRES_USER=taxibek
POSTGRES_PASSWORD=CHANGE_ME

# Redis (required in prod — session store + rate limit)
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# Bot admins (Telegram user IDs)
ADMIN_IDS=[123456789]

# Webapp (manager panel)
WEBAPP_URL=https://your-domain.com
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SESSION_TTL_SECONDS=86400
# Set true when behind HTTPS
SESSION_SECURE_COOKIE=false

# Other
DEFAULT_ROUTE_ID=1
CONTACT_PHONE=+998909717870
